{
  "name": "modern-flash",
  "version": "1.0.0",
  "description": "SVG-based Flash animation engine and prompt-driven animation studio for Next.js and WordPress.",
  "repository": {
    "type": "git",
    "url": "https://github.com/goldlabelapps/modern-flash.git"
  },
  "homepage": "https://github.com/goldlabelapps/modern-flash#readme",
  "license": "MIT",
  "author": "Goldlabel°",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/flash-bundle.min.js",
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:bundle && pnpm run build:vite",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:vite": "vite build --config vite.config.ts",
    "build:studio": "vite build --config vite.config.ts",
    "build:nextjs": "pnpm --filter nextjs build",
    "build:web": "pnpm --filter nextjs build",
    "build:wp": "pnpm run build:bundle",
    "type-check": "tsc --noEmit",
    "sfx:curate": "python3 scripts/curate-sound-library.py",
    "test": "python3 scripts/verify-hygiene.py",
    "test:flash": "python3 scripts/test-flash.py",
    "vite": "vite --port 3800 --host",
    "studio": "vite --port 3800 --host",
    "nextjs": "pnpm --filter nextjs dev",
    "web": "pnpm --filter nextjs dev"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
