{
  "name": "react-playing-cards",
  "version": "1.0.0",
  "description": "SVG-based Flash animation engine and prompt-driven animation studio for Next.js and WordPress.",
  "license": "MIT",
  "author": "Goldlabel°",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/flash-bundle.min.js",
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "type-check": "tsc --noEmit",
    "test": "python3 scripts/verify-hygiene.py",
    "studio": "vite --port 3800 --host"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
